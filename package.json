{
  "name": "tripwire",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "demo": "DEMO_FALLBACK=1 tsx scripts/dev.ts",
    "demo:live": "DEMO_FALLBACK=0 tsx services/mole/src/cli.ts hire",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -C frontend typecheck",
    "smoke": "tsx scripts/smoke.ts",
    "mole": "tsx services/mole/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@tripwire/adapters": "workspace:*",
    "@tripwire/agent-harness": "workspace:*",
    "mole": "workspace:*",
    "sparta_worlds": "0.9.0-beta.5"
  }
}
