# Tripwire — environment
# Copy to `.env` and fill in what you have. Everything is optional: any sponsor without a key
# falls back to a deterministic mock, and `pnpm demo` (DEMO_FALLBACK=1) runs the whole thing with
# zero keys and produces the exact same on-screen result as a live run.

# ── Demo / fallback ──────────────────────────────────────────────────────────
# 1 = force every sponsor to its mock (no network, no keys). `pnpm demo` sets this for you.
DEMO_FALLBACK=0

# ── Sparta Worlds (the simulated Stripe + Zendesk company the agents act in) ───
# Live mode runs `worlds serve` locally; `pnpm dev` starts it for you on WORLDS_PORT.
WORLDS_URL=http://127.0.0.1:4242
WORLDS_PORT=4242
# Operator token for /admin/* (16+ chars). Auto-provisioned by the server if left blank.
WORLDS_ADMIN_TOKEN=

# ── Dial (phone alerts + canary phone numbers) ────────────────────────────────
# When a high/critical tripwire fires, Tripwire places a voice call to OWNER_PHONE.
DIAL_API_KEY=
DIAL_FROM_NUMBER=
OWNER_PHONE=+1XXXXXXXXXX
# Pool of real Dial numbers planted as PII canaries. If an agent dials one, that inbound call is a trip.
DIAL_CANARY_NUMBERS=+1XXXXXXXXXX,+1XXXXXXXXXX
# Verify inbound Dial webhooks (account-level + signed). Leave blank to skip verification locally.
DIAL_WEBHOOK_SECRET=
# 1 = actually let the egress monitor place real calls to canary numbers (opt-in; off by default).
LIVE_CANARY_CALLS=0

# ── Keewano (ordered, typed event store — powers cross-run fleet intelligence) ─
KEEWANO_API_KEY=
KEEWANO_PAT=
KEEWANO_PROJECT_ID=
KEEWANO_EMAIL=
# Local ordered mirror used for the live kill-chain replay (Keewano ingest is ~5 min behind).
KEEWANO_MIRROR=data/keewano-mirror.jsonl

# ── Darwin (agentic web search — skill/MCP provenance lookups) ────────────────
DARWIN_API_KEY=

# ── GitHub watch (callback-free detection: a planted secret appearing in a commit) ──
# A classic-or-fine-grained token with code-search read. Mocked when unset.
GITHUB_TOKEN=

# ── Collector / app ports ─────────────────────────────────────────────────────
# Hostname planted into canary tracking URLs (GET /t/:id back here = called home).
COLLECTOR_HOST=track.fernway-deliveries.com
PORT=8787
VITE_PORT=5173
