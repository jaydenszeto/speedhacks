# Mole — environment
# Copy to `.env` and fill in what you have, then run `pnpm mole doctor` to see what's live.
# Everything is optional: any sponsor without a key falls back to a deterministic mock. Mole never
# prints "safe" and never fakes output — a missing key downgrades a check to a warning, it does not
# invent a result. `DEMO_FALLBACK=1` forces full replay and prints a visible REPLAY banner.

# ── Demo / fallback ──────────────────────────────────────────────────────────
# 1 = force every sponsor to its mock and replay recorded data (prints a REPLAY banner). Off for a real run.
DEMO_FALLBACK=0

# ── Sparta Worlds (the simulated Stripe + Zendesk company the agent acts in) ───
# `mole run` auto-starts a local worlds server here if one isn't already reachable.
WORLDS_URL=http://127.0.0.1:4242
WORLDS_PORT=4242
# Operator token for /admin/* (16+ chars). Auto-provisioned by the server if left blank.
WORLDS_ADMIN_TOKEN=

# ── Dial (phone alerts + canary phone numbers) ────────────────────────────────
# When a high/critical trip fires during `mole run`, Mole places a voice call to OWNER_PHONE
# (masked to its last two digits everywhere it is printed).
DIAL_API_KEY=
DIAL_FROM_NUMBER=
OWNER_PHONE=+1XXXXXXXXXX
# Pool of real Dial numbers planted as PII canaries. If an agent dials one, that inbound call is a trip.
DIAL_CANARY_NUMBERS=+1XXXXXXXXXX,+1XXXXXXXXXX
# Verify inbound Dial webhooks (account-level + signed). Leave blank to skip verification locally.
DIAL_WEBHOOK_SECRET=
# 1 = actually let the egress monitor place real calls to canary numbers (opt-in; off by default).
LIVE_CANARY_CALLS=0

# ── Keewano (ordered, typed event store — powers cross-run fleet intelligence) ─
# Supplies "previous trips for this skill" in `mole report`. Without a key, a local mirror is used.
KEEWANO_API_KEY=
KEEWANO_PAT=
KEEWANO_PROJECT_ID=
KEEWANO_EMAIL=
# Local ordered mirror of fleet history (Keewano ingest is ~5 min behind).
KEEWANO_MIRROR=data/keewano-mirror.jsonl

# ── GitHub watch (callback-free detection: a planted secret appearing in a commit) ──
# A classic-or-fine-grained token with code-search read. Mocked when unset.
GITHUB_TOKEN=

# ── Collector / app ports ─────────────────────────────────────────────────────
# Hostname planted into canary tracking URLs (GET /t/:id back here = called home).
COLLECTOR_HOST=track.fernway-deliveries.com
PORT=8787
VITE_PORT=5173
